{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SymEngine shared binding behavioral test cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arrange", "call", "expect"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "arrange": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "integer": {"type": "integer"},
                "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
              }
            }
          },
          "call": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function", "arguments"],
            "properties": {
              "function": {"type": "string", "minLength": 1},
              "arguments": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["string"],
            "properties": {
              "string": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
